{
  "properties": {
    "displayName": "ERP - Restrict regions and VM sizes",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Data residency plus cost control in one policy. Resources may only be created in approved Indian regions, and only from an approved VM size list so nobody can accidentally deploy a GPU node and burn the learning budget.",
    "metadata": {
      "version": "1.0.0",
      "category": "General",
      "owner": "platform-engineering@contoso.com"
    },
    "parameters": {
      "allowedLocations": {
        "type": "Array",
        "defaultValue": ["centralindia", "southindia", "westindia"],
        "metadata": {
          "displayName": "Allowed locations",
          "strongType": "location"
        }
      },
      "allowedVmSizes": {
        "type": "Array",
        "defaultValue": [
          "Standard_B2s",
          "Standard_B2ms",
          "Standard_D2s_v5",
          "Standard_D4s_v5",
          "Standard_D2as_v5",
          "Standard_D4as_v5"
        ],
        "metadata": {
          "displayName": "Allowed VM sizes",
          "strongType": "vmSize"
        }
      }
    },
    "policyRule": {
      "if": {
        "anyOf": [
          {
            "allOf": [
              { "field": "location", "notIn": "[parameters('allowedLocations')]" },
              { "field": "location", "notEquals": "global" }
            ]
          },
          {
            "allOf": [
              { "field": "type", "equals": "Microsoft.Compute/virtualMachines" },
              {
                "field": "Microsoft.Compute/virtualMachines/sku.name",
                "notIn": "[parameters('allowedVmSizes')]"
              }
            ]
          },
          {
            "allOf": [
              { "field": "type", "equals": "Microsoft.Compute/virtualMachineScaleSets" },
              {
                "field": "Microsoft.Compute/virtualMachineScaleSets/sku.name",
                "notIn": "[parameters('allowedVmSizes')]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "Deny"
      }
    }
  }
}
